                  <!-- Eye-in-hand camera: mounted on the wrist, looking down the
                       gripper approach axis (+z of link6) so it sees the fingers
                       and the object being grasped. Secondary POV. -->
                  <camera name="wrist" pos="0 -0.07 0.02" xyaxes="1 0 0 0 -1 0"
                          fovy="80"/>
                  <!-- Grasp centre: midpoint of the volume enclosed by the two
                       finger pads. Measured from the pad geoms below: the pads
                       occupy link6-frame z in [0.075, 0.135], so the centre is
                       z=0.105. (The old 0.09 sat at the *inner* pad and the
                       original 0.17 was past the fingertips entirely -- both made
                       IK targets collide the fingers with the object.) -->
                  <site name="tcp" pos="0 0 0.105" size="0.008"
                        rgba="1 0.8 0.2 0.6"/>
                  <!-- Pinch axis reference: +y of link6 is the finger-opening
                       direction. Used to orient grasps about the approach axis. -->
