      <inertial pos="-0.00979275 1.82906e-06 0.04101" quat="0.692988 -0.137524 -0.137826 0.69416" mass="0.162549"
        diaginertia="0.000269445 0.000227478 0.000221437"/>
      <geom class="visual" density="0" mesh="base_link" material="gray_mat"/>
      <geom name="base_col" class="collision" mesh="base_link"/>

      <!-- ================= FOREHEAD CAMERA =================================
           Fixed first-person camera on a gooseneck bracket behind and above the
           arm base, tilted down at the workspace. Rigidly attached to
           base_link, so it travels with the robot but NOT with the arm -- the
           sim twin of a camera bolted to the PIPER's mounting plate.

             pos  : 25 cm behind the base axis, 30 cm above the base flange
                    (=> 0.50 m above the floor / 0.30 m above the table)
             aim  : ~25 deg below horizontal, centred on (0.36, 0, 0.21),
                    which frames the whole reachable workspace including both
                    the source and destination pads
             fovy : 65 deg vertical -- a wide-angle RGB module such as the
                    colour stream of a RealSense D435 (69 deg H / 42 deg V) or
                    a generic 120 deg-diagonal USB camera

           Position was chosen empirically: mounted closer in (<= 15 cm behind
           the base) the arm's own link2 fills the frame at the home pose and
           the object is never visible.

           MuJoCo cameras look down their own -z with +y up, hence xyaxes:
             x = (0, -1, 0)          image right = world -y = robot's right
             y = (0.429, 0, 0.903)   image up
        ================================================================== -->
      <camera name="forehead" pos="-0.25 0 0.30" xyaxes="0 -1 0 0.4293 0 0.9031"
              fovy="65"/>
      <!-- Bracket, purely cosmetic (no collision), so the camera is visible in
           third-person renders instead of being a floating viewpoint. -->
      <geom name="cam_mast" type="capsule" fromto="-0.10 0 0.02 -0.278 0 0.295"
            size="0.008" rgba="0.15 0.15 0.17 1" contype="0" conaffinity="0"
            group="2" density="0"/>
      <!-- Housing sits BEHIND the lens along the view axis; put it in front and
           it fills the entire forehead image with a black blob. -->
      <geom name="cam_head" type="box" size="0.014 0.038 0.014"
            pos="-0.281 0 0.313" rgba="0.1 0.1 0.12 1" contype="0"
            conaffinity="0" group="2" density="0"/>
