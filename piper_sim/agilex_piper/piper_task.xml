<mujoco model="piper_pick_place">
  <!--
    AgileX Piper pick-and-place task. Includes the Menagerie piper model
    (piper.xml, with a wrist "forehead" camera + tcp site added) and adds a
    table, an object, source/destination pads, and external cameras.

    Lives inside agilex_piper/ so the model's meshdir="assets" resolves.
    POVs: "wrist" (eye-in-hand, on link6), "front", "side", "top", "overview".
  -->
  <include file="piper.xml"/>

  <statistic center="0.3 0 0.3" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="table" rgba="0.55 0.45 0.35 1"/>
    <material name="cube" rgba="0.85 0.3 0.25 1"/>
    <material name="src" rgba="0.3 0.5 0.85 0.9"/>
    <material name="dst" rgba="0.3 0.8 0.4 0.9"/>
  </asset>

  <worldbody>
    <light pos="0.3 0 1.6" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- One work surface (top at z=0.20). The arm is mounted ON it at the
         origin and reaches down onto objects in front -- the natural desk setup. -->
    <geom name="table" type="box" size="0.40 0.35 0.10" pos="0.26 0 0.10"
          material="table"/>

    <!-- Object to pick: a tall-ish block (like a small bottle) so the gripper
         grasps its upper body with the fingertips clear of the table. -->
    <body name="obj" pos="0.35 -0.12 0.246">
      <freejoint name="obj_free"/>
      <geom name="obj_geom" type="box" size="0.022 0.022 0.045" material="cube"
            mass="0.03" friction="2.0 0.1 0.01" solref="0.006 1"
            solimp="0.95 0.99 0.001"/>
    </body>

    <!-- Source (blue) and destination (green) pads on the table, visual only. -->
    <geom name="pad_src" type="cylinder" size="0.05 0.001" pos="0.35 -0.12 0.201"
          material="src" contype="0" conaffinity="0"/>
    <geom name="pad_dst" type="cylinder" size="0.05 0.001" pos="0.35 0.15 0.201"
          material="dst" contype="0" conaffinity="0"/>
    <site name="dest" pos="0.35 0.15 0.24" size="0.008" rgba="0.3 0.8 0.4 0.9"/>

    <!-- External POV cameras (the wrist/forehead cam is on link6). -->
    <camera name="front" pos="1.15 0 0.6" xyaxes="0 1 0 -0.5 0 0.87"/>
    <camera name="side" pos="0.42 -1.0 0.6" xyaxes="1 0 0 0 0.5 0.87"/>
    <camera name="top" pos="0.42 0 1.3" xyaxes="1 0 0 0 1 0"/>
    <camera name="overview" pos="1.0 -0.85 0.8" xyaxes="0.65 0.76 0 -0.45 0.38 0.8"/>
  </worldbody>

  <keyframe>
    <!-- arm(8) + object free-joint(7). Arm in a ready pose, gripper open. -->
    <key name="home"
         qpos="0 1.2 -1.2 0 0.6 0 0.035 -0.035 0.35 -0.12 0.246 1 0 0 0"
         ctrl="0 1.2 -1.2 0 0.6 0 0.035"/>
  </keyframe>
</mujoco>
