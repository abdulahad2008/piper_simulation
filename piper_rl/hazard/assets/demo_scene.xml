<!--
  Minimal scene for testing the hazard metrics without the arm:
  a knife on a free joint driven by mocap, and a human forearm + hand as
  capsules on a second mocap body. Same capsule convention as the
  piper_simulation human (orange forearm and hand).
-->
<mujoco model="hazard_demo">
  <option timestep="0.002" gravity="0 0 0"/>
  <worldbody>
    <light pos="0 0 2"/>
    <geom name="table" type="box" size="0.4 0.4 0.02" pos="0 0 -0.02" rgba="0.4 0.5 0.3 1"/>

    <body name="knife_mocap" mocap="true" pos="0 0 0.15">
      <body name="knife" pos="0 0 0">
        <geom name="knife_handle" type="box" size="0.055 0.011 0.013" pos="-0.055 0 0" rgba="0.12 0.08 0.05 1" mass="0.08"/>
        <geom name="knife_blade" type="box" size="0.100 0.001 0.020" pos="0.100 0 0" rgba="0.75 0.77 0.80 1" mass="0.08"/>
        <site name="blade_heel" pos="0.000 0 0.020" size="0.003" rgba="1 0 0 1"/>
        <site name="blade_tip"  pos="0.200 0 0.020" size="0.003" rgba="1 0 0 1"/>
        <site name="blade_frame" pos="0.100 0 0.020" size="0.002" rgba="0 1 0 0.5"/>
      </body>
    </body>

    <body name="human_mocap" mocap="true" pos="0.35 0.3 0.15">
      <geom name="human_forearm" type="capsule" size="0.035 0.12" fromto="0 0.24 0 0 0 0" rgba="1 0.55 0.1 1"/>
      <geom name="human_hand" type="sphere" size="0.045" pos="0 -0.04 0" rgba="1 0.55 0.1 1"/>
    </body>
  </worldbody>
</mujoco>
